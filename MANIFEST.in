include README.md config.example.toml requirements.lock.txt
include DEPLOYMENT.md CONNECTION.md .gitignore
recursive-include src/agent_observer/templates *.toml
recursive-include scripts *.py *.sh
recursive-include tests *.py *.md
recursive-include docs *.md
recursive-include examples *.toml
recursive-include deploy *.service *.md
recursive-include reports *.md
recursive-include .github/workflows *.yml
global-exclude __pycache__ *.py[cod]
prune tests/.generated
